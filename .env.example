# ── FormatPulse Environment Configuration ─────────────────────────────────────
# All variables prefixed with VITE_ are exposed to the browser client.

# ── Polar.sh Payment Checkout Links (0% Monthly Fee MoR) ────────────────────
# Create 3 products at https://polar.sh/dashboard/products and paste the checkout URLs here:
VITE_CHECKOUT_URL_INDIVIDUAL="https://buy.polar.sh/polar_cl_individual_pro"
VITE_CHECKOUT_URL_TEAM="https://buy.polar.sh/polar_cl_team_pack"
VITE_CHECKOUT_URL_ENTERPRISE="https://buy.polar.sh/polar_cl_enterprise"

# ── Optional: Remote License Verification URL ────────────────────────────────
# If omitted, FormatPulse validates all keys 100% offline using FNV-1a checksums.
# VITE_MOR_VALIDATE_URL="https://formatpulse.vercel.app/api/validate"

# ── Webhook Fulfillment Secret (Vercel Serverless Function) ──────────────────
# Set in Vercel Project Settings > Environment Variables:
# POLAR_WEBHOOK_SECRET="polar_whsec_..."
